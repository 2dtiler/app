/*
  # Strong HSTS policy (2 years, include subdomains, preload-eligible)
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # Block clickjacking (redundant with frame-ancestors in CSP, kept as legacy fallback)
  X-Frame-Options: DENY

  # Prevent MIME-type sniffing
  X-Content-Type-Options: nosniff

  # Limit referrer info on cross-origin navigations
  Referrer-Policy: strict-origin-when-cross-origin

  # Origin isolation: allow popups so AdSense landing pages still get opener info
  Cross-Origin-Opener-Policy: same-origin-allow-popups

  # Restrict powerful features not used by this app
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

  # ── Content Security Policy ────────────────────────────────────────────────
  # default-src: fall-back for anything not listed explicitly
  # script-src:  self + Google AdSense / Ad Manager domains
  # style-src:   unsafe-inline required for Radix UI / Tailwind inline styles
    #              plus Google Fonts stylesheet loading
  # img-src:     data: / blob: for canvas exports; https: for ad images
  # font-src:    self only (no remote fonts currently used)
    # font-src:    self + Google Fonts font files
  # connect-src: Sentry ingest + AdSense reporting
  # frame-src:   Google Ad iframes
  # worker-src:  blob: for Vite-generated web workers
  # object-src:  none (no Flash / plugins)
  # base-uri:    self (prevent base-tag injection)
  # form-action: self (no external form submissions)
  # frame-ancestors: none (blocks clickjacking; supersedes X-Frame-Options)
  # upgrade-insecure-requests: force HTTP→HTTPS for sub-resources
  # script-src: self + Google AdSense / Ad Manager + Cloudflare Insights beacon
  # connect-src:    Sentry ingest + AdSense reporting + Cloudflare Insights RUM endpoint + Puter.js AI API + OpenAI + Together.xyz + xAI
