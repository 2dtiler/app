---
---

<section class="hero">
	<!-- Gradient orbs -->
	<div class="hero-bg" aria-hidden="true">
		<div class="orb orb-1"></div>
		<div class="orb orb-2"></div>
		<div class="orb orb-3"></div>
	</div>

	<!-- Subtle tile grid decoration -->
	<div class="hero-grid-deco" aria-hidden="true"></div>

	<div class="hero-inner">
		<div class="hero-content">
			<div class="hero-badge reveal">
				<span class="badge-dot"></span>
				Free &amp; Local-First
			</div>

			<h1 class="hero-title reveal reveal-delay-1">
				Build beautiful tile maps
				<span class="gradient-text">in your browser.</span>
			</h1>

			<p class="hero-subtitle reveal reveal-delay-2">
				A powerful tile map editor powered by PixiJS. Paint with brushes,
				manage layers, place objects, and export your work — no account needed.
			</p>

			<div class="hero-actions reveal reveal-delay-3">
				<a href="#" class="btn-primary">
					Open Editor
					<svg width="18" height="18" viewBox="0 0 18 18" fill="none">
						<path d="M7 4L13 9L7 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
				</a>
				<a href="#features" class="btn-ghost">
					Explore Features
					<svg width="18" height="18" viewBox="0 0 18 18" fill="none">
						<path d="M9 4V14M9 14L5 10M9 14L13 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
				</a>
			</div>
		</div>

		<div class="hero-preview reveal reveal-delay-4">
			<div class="preview-window">
				<div class="preview-topbar">
					<div class="preview-dots">
						<span class="dot-rose"></span>
						<span class="dot-amber"></span>
						<span class="dot-mint"></span>
					</div>
					<span class="preview-title">2D Tiler</span>
					<span class="preview-spacer"></span>
				</div>
				<div class="preview-body">
					<!-- Stylized app mockup -->
					<div class="mock-sidebar">
						<div class="mock-tile-grid">
							<span style="background: var(--lavender-light)"></span>
							<span style="background: var(--peach-light)"></span>
							<span style="background: var(--mint-light)"></span>
							<span style="background: var(--sky-light)"></span>
							<span style="background: var(--rose-light)"></span>
							<span style="background: var(--amber-light)"></span>
							<span style="background: var(--lavender-pale)"></span>
							<span style="background: var(--peach)"></span>
							<span style="background: var(--mint-light)"></span>
							<span style="background: var(--lavender-light)"></span>
							<span style="background: var(--sky-light)"></span>
							<span style="background: var(--rose-light)"></span>
						</div>
					</div>
					<div class="mock-canvas">
						<div class="mock-grid-lines"></div>
						<div class="mock-painted-tiles">
							<span style="background: var(--mint-light); grid-area: 2/3/3/4;"></span>
							<span style="background: var(--mint-light); grid-area: 2/4/3/5;"></span>
							<span style="background: var(--mint); grid-area: 3/3/4/4; opacity:0.5;"></span>
							<span style="background: var(--mint); grid-area: 3/4/4/5; opacity:0.5;"></span>
							<span style="background: var(--lavender-light); grid-area: 4/5/5/6;"></span>
							<span style="background: var(--lavender-light); grid-area: 4/6/5/7;"></span>
							<span style="background: var(--lavender-light); grid-area: 5/5/6/6;"></span>
							<span style="background: var(--lavender-light); grid-area: 5/6/6/7;"></span>
							<span style="background: var(--peach-light); grid-area: 6/2/7/3;"></span>
							<span style="background: var(--peach-light); grid-area: 6/3/7/4;"></span>
							<span style="background: var(--peach-light); grid-area: 7/2/8/3;"></span>
							<span style="background: var(--amber-light); grid-area: 3/7/4/8;"></span>
							<span style="background: var(--amber-light); grid-area: 3/8/4/9;"></span>
							<span style="background: var(--sky-light); grid-area: 5/2/6/3;"></span>
							<span style="background: var(--rose-light); grid-area: 7/6/8/7;"></span>
							<span style="background: var(--rose-light); grid-area: 7/7/8/8;"></span>
						</div>
						<p class="mock-label">Your screenshot here</p>
					</div>
					<div class="mock-right-panel">
						<div class="mock-layers">
							<div class="mock-layer active"><span class="mock-layer-icon"></span> Terrain</div>
							<div class="mock-layer"><span class="mock-layer-icon"></span> Objects</div>
							<div class="mock-layer"><span class="mock-layer-icon"></span> Background</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		padding: calc(var(--nav-height) + 60px) 24px 80px;
		min-height: 100vh;
		display: flex;
		align-items: center;
		overflow: hidden;
	}

	/* Gradient orbs */
	.hero-bg {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.orb {
		position: absolute;
		border-radius: 50%;
		filter: blur(100px);
	}

	.orb-1 {
		width: 600px;
		height: 600px;
		background: var(--lavender-light);
		opacity: 0.35;
		top: -10%;
		right: -5%;
		animation: float-1 18s ease-in-out infinite;
	}

	.orb-2 {
		width: 500px;
		height: 500px;
		background: var(--peach-light);
		opacity: 0.3;
		bottom: -10%;
		left: -5%;
		animation: float-2 22s ease-in-out infinite;
	}

	.orb-3 {
		width: 400px;
		height: 400px;
		background: var(--mint-light);
		opacity: 0.25;
		top: 40%;
		left: 40%;
		animation: float-3 20s ease-in-out infinite;
	}

	@keyframes float-1 {
		0%, 100% { transform: translate(0, 0); }
		33% { transform: translate(-30px, 20px); }
		66% { transform: translate(20px, -30px); }
	}

	@keyframes float-2 {
		0%, 100% { transform: translate(0, 0); }
		33% { transform: translate(25px, -15px); }
		66% { transform: translate(-20px, 25px); }
	}

	@keyframes float-3 {
		0%, 100% { transform: translate(0, 0); }
		33% { transform: translate(-20px, -20px); }
		66% { transform: translate(15px, 15px); }
	}

	/* Subtle grid decoration */
	.hero-grid-deco {
		position: absolute;
		inset: 0;
		opacity: 0.04;
		background-image:
			linear-gradient(var(--lavender) 1px, transparent 1px),
			linear-gradient(90deg, var(--lavender) 1px, transparent 1px);
		background-size: 48px 48px;
		pointer-events: none;
		mask-image: radial-gradient(ellipse 60% 60% at 50% 40%, black 0%, transparent 70%);
		-webkit-mask-image: radial-gradient(ellipse 60% 60% at 50% 40%, black 0%, transparent 70%);
	}

	/* Inner layout */
	.hero-inner {
		max-width: var(--max-width);
		margin: 0 auto;
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 56px;
		position: relative;
		z-index: 1;
	}

	.hero-content {
		max-width: 720px;
	}

	/* Badge */
	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-display);
		font-size: 13px;
		font-weight: 600;
		color: var(--lavender);
		background: var(--lavender-pale);
		padding: 6px 16px;
		border-radius: 100px;
		margin-bottom: 24px;
		letter-spacing: 0.02em;
	}

	.badge-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--lavender);
		animation: pulse-dot 2s ease-in-out infinite;
	}

	@keyframes pulse-dot {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.5; transform: scale(1.4); }
	}

	/* Title */
	.hero-title {
		font-size: clamp(36px, 6.5vw, 64px);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.03em;
		margin-bottom: 20px;
	}

	.gradient-text {
		background: linear-gradient(135deg, var(--lavender) 0%, var(--peach) 50%, var(--rose) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	/* Subtitle */
	.hero-subtitle {
		font-size: clamp(16px, 2.5vw, 19px);
		color: var(--text-muted);
		line-height: 1.7;
		margin: 0 auto 32px;
		max-width: 560px;
	}

	/* Actions */
	.hero-actions {
		display: flex;
		gap: 14px;
		justify-content: center;
		flex-wrap: wrap;
	}

	.btn-primary, .btn-ghost {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 16px;
		padding: 14px 28px;
		border-radius: 100px;
		transition: all 0.2s ease;
	}

	.btn-primary {
		color: white;
		background: var(--lavender);
		box-shadow: 0 4px 20px rgba(167, 139, 218, 0.3);
	}

	.btn-primary:hover {
		background: #9578D0;
		transform: translateY(-2px);
		box-shadow: 0 8px 32px rgba(167, 139, 218, 0.4);
	}

	.btn-ghost {
		color: var(--text-muted);
		background: transparent;
		border: 1.5px solid var(--border);
	}

	.btn-ghost:hover {
		color: var(--text);
		border-color: var(--lavender-light);
		background: rgba(167, 139, 218, 0.06);
	}

	/* Preview window */
	.hero-preview {
		width: 100%;
		max-width: 900px;
	}

	.preview-window {
		background: var(--surface);
		border-radius: var(--radius-lg);
		border: 1px solid var(--border);
		box-shadow: var(--shadow-lg);
		overflow: hidden;
	}

	.preview-topbar {
		display: flex;
		align-items: center;
		padding: 12px 16px;
		background: linear-gradient(180deg, #F8F4FC 0%, #F3EEF8 100%);
		border-bottom: 1px solid var(--border);
	}

	.preview-dots {
		display: flex;
		gap: 7px;
	}

	.preview-dots span {
		width: 11px;
		height: 11px;
		border-radius: 50%;
	}

	.dot-rose { background: var(--rose); }
	.dot-amber { background: var(--amber); }
	.dot-mint { background: var(--mint); }

	.preview-title {
		font-family: var(--font-display);
		font-size: 12px;
		font-weight: 600;
		color: var(--text-light);
		margin-left: 16px;
		letter-spacing: 0.06em;
	}

	.preview-spacer {
		flex: 1;
	}

	.preview-body {
		display: flex;
		height: 360px;
		background: #FDFBF9;
	}

	/* Mock sidebar */
	.mock-sidebar {
		width: 120px;
		flex-shrink: 0;
		padding: 12px;
		border-right: 1px solid var(--border);
		background: rgba(243, 237, 247, 0.3);
	}

	.mock-tile-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 4px;
	}

	.mock-tile-grid span {
		aspect-ratio: 1;
		border-radius: 4px;
	}

	/* Mock canvas */
	.mock-canvas {
		flex: 1;
		position: relative;
		overflow: hidden;
	}

	.mock-grid-lines {
		position: absolute;
		inset: 0;
		opacity: 0.06;
		background-image:
			linear-gradient(var(--text) 1px, transparent 1px),
			linear-gradient(90deg, var(--text) 1px, transparent 1px);
		background-size: 40px 40px;
	}

	.mock-painted-tiles {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-columns: repeat(9, 40px);
		grid-template-rows: repeat(9, 40px);
	}

	.mock-painted-tiles span {
		border-radius: 3px;
		margin: 2px;
	}

	.mock-label {
		position: absolute;
		bottom: 20px;
		left: 50%;
		transform: translateX(-50%);
		font-family: var(--font-display);
		font-size: 13px;
		color: var(--text-light);
		background: rgba(255, 255, 255, 0.8);
		padding: 6px 16px;
		border-radius: 100px;
		border: 1px solid var(--border);
		white-space: nowrap;
	}

	/* Mock right panel */
	.mock-right-panel {
		width: 130px;
		flex-shrink: 0;
		padding: 12px;
		border-left: 1px solid var(--border);
		background: rgba(243, 237, 247, 0.3);
	}

	.mock-layers {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.mock-layer {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-display);
		font-size: 11px;
		color: var(--text-light);
		padding: 6px 8px;
		border-radius: 6px;
		transition: background 0.2s;
	}

	.mock-layer.active {
		background: var(--lavender-pale);
		color: var(--lavender);
		font-weight: 600;
	}

	.mock-layer-icon {
		width: 10px;
		height: 10px;
		border-radius: 3px;
		background: currentColor;
		opacity: 0.35;
	}

	.mock-layer.active .mock-layer-icon {
		opacity: 0.6;
	}

	/* Responsive */
	@media (max-width: 768px) {
		.hero {
			padding: calc(var(--nav-height) + 40px) 20px 60px;
		}

		.preview-body {
			height: 240px;
		}

		.mock-sidebar, .mock-right-panel {
			display: none;
		}

		.btn-primary, .btn-ghost {
			padding: 12px 24px;
			font-size: 15px;
		}
	}
</style>
